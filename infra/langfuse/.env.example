# Secrets for the self-hosted Langfuse stack (infra/langfuse/docker-compose.yml).
# Copy to infra/langfuse/.env (git-ignored) and replace every value, e.g. with
#   python -c "import secrets; print(secrets.token_hex(32))"
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_SALT=
# 64 hex characters (32 bytes)
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
# Project API keys created on first start; the app uses the same values (root .env).
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-
# Local Langfuse UI login (http://localhost:3100)
LANGFUSE_ADMIN_EMAIL=admin@northstar-legal.example
LANGFUSE_ADMIN_PASSWORD=
