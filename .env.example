# Copy to .env and adjust. Never commit .env.

# PostgreSQL (docker compose service, published on host port 5433)
POSTGRES_USER=intake
POSTGRES_PASSWORD=intake_dev_password
POSTGRES_DB=legal_intake
POSTGRES_HOST_PORT=5433

DATABASE_URL=postgresql+psycopg://intake:intake_dev_password@localhost:5433/legal_intake
# Tests refuse to run unless the database name ends in "_test" (tables are truncated).
TEST_DATABASE_URL=postgresql+psycopg://intake:intake_dev_password@localhost:5433/legal_intake_test

# Slug of the firm created by scripts/seed_demo_data.py
DEMO_FIRM_SLUG=northstar-legal

# Phase 2+ (not used yet)
ANTHROPIC_API_KEY=replace-me
