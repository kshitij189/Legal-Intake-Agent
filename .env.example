# Copy to .env and adjust. Never commit .env.

# PostgreSQL (docker compose service, published on host port 5433)
POSTGRES_USER=intake
POSTGRES_PASSWORD=intake_dev_password
POSTGRES_DB=legal_intake
POSTGRES_HOST_PORT=5433

DATABASE_URL=postgresql+psycopg://intake:intake_dev_password@localhost:5433/legal_intake
# Tests refuse to run unless the database name ends in "_test" (tables are truncated).
TEST_DATABASE_URL=postgresql+psycopg://intake:intake_dev_password@localhost:5433/legal_intake_test

# Slug of the firm created by scripts/seed_demo_data.py
DEMO_FIRM_SLUG=northstar-legal

# LLM model chain in priority order (Phase 2+): Gemini primary, Groq fallback.
# Entries are provider[:model]; free-tier quotas are per model (gemini-3.8-flash: 20 requests/day
# measured 2026-10-11). Entries whose provider key is missing or 'replace-me' are skipped.
LLM_PROVIDERS=gemini:gemini-3.8-flash,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b

# Gemini: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.8-flash

# Groq: create a key at https://console.groq.com/keys
GROQ_API_KEY=replace-me
# Production model with tool calling. Alternative on this account: openai/gpt-oss-20b
# (llama-3.3-70b-versatile returned 404 model_not_found for this key on 2026-10-11)
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
# Max seconds one model call waits out 429 rate limits (free tier: 8,000 tokens/minute)
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=30

# Voice (Phase 4). LiveKit dev-mode credentials - local development only.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# STT: faster-whisper. auto = CUDA float16 when available (run scripts/enable_gpu.py), else CPU int8.
STT_MODEL=base.en
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto
# TTS: auto = Kokoro when its GPU path works, else Piper (Kokoro on CPU is ~11x slower).
TTS_ENGINE=auto
KOKORO_VOICE=af_heart
# auto uses Kokoro only on GPUs with at least this much memory (MiB); below it, Piper.
KOKORO_MIN_GPU_MIB=6144
# Pre-spawned job processes; each loads its own models (1 fits a 4 GB GPU).
VOICE_IDLE_PROCESSES=1

# Durable workflows (Phase 5) - Temporal dev server from docker compose (UI: http://127.0.0.1:8233)
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=legal-intake
BOOKING_VIA_WORKFLOW=true
BOOKING_WAIT_SECONDS=12
# Fault injection for tests/demos only (leave empty): see backend/app/workflows/faults.py
CALENDAR_FAULT_INJECTION=
NOTIFIER_FAULT_INJECTION=

# Review dashboard (Phase 7). Password given to every fictional staff member by
# scripts/seed_demo_data.py (min 10 characters; local demo only). Leave unset to disable logins.
# DEMO_STAFF_PASSWORD=<choose one, 10+ characters>
# HTTP on 127.0.0.1 in the local demo; set true only behind HTTPS.
DASHBOARD_COOKIE_SECURE=false
# Nudge running handoff workflows after accept/resolve (the database stays authoritative).
HANDOFF_SIGNAL_ENABLED=true
